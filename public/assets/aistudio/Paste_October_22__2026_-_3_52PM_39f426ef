## ۶. شبه‌کد کامل یکپارچه (Python)

```python
def compute_importance(model, tokenizer, prompt, config):
    # ---------- گام ۰: تولید مرجع ----------
    input_ids = tokenizer.encode(prompt)
    N = len(input_ids)
    
    # ---------- گام ۱: آماده‌سازی بر اساس mask_scheme ----------
    if config['mask_scheme'] in ['zero', 'remove']:
        # حالت A: forward کامل روی S
        Y = model.generate(input_ids, max_new_tokens=config['m'], do_sample=False)
        S = input_ids + Y
        embeddings = model.get_embeddings(S)
        logits = model.forward(embeddings)
        past_kv = None  # استفاده نمی‌شود
        
    else:  # 'evict'
        # حالت B: prefill + cache
        past_kv = model.prefill(input_ids)
        Y, logits_per_step = model.generate_with_cache(
            input_ids, past_kv, 
            max_new_tokens=config['m'], 
            return_logits=True
        )
        S = input_ids + Y
        logits = None  # استفاده نمی‌شود
    
    imp = np.zeros(N)
    eps = config['epsilon']
    
    # ---------- گام ۲ و ۳: حلقه‌های اصلی ----------
    for k in range(config['m']):
        logit_pos = N + k - 1
        C = N + k
        
        # توزیع کامل
        if config['mask_scheme'] in ['zero', 'remove']:
            p_full = softmax(logits[0, logit_pos, :])
        else:  # 'evict'
            p_full = softmax(logits_per_step[k])
        
        for i in range(C):
            if i >= N:
                continue
            
            # ---------- ۳.۱: اعمال مداخله ----------
            if config['mask_scheme'] == 'zero':
                emb_masked = embeddings.clone()
                emb_masked[0, i, :] = 0.0
                logits_masked = model.forward(emb_masked)
                new_logit_pos = logit_pos
                
            elif config['mask_scheme'] == 'remove':
                S_masked = S[:i] + S[i+1:]
                emb_masked = model.get_embeddings(S_masked)
                logits_masked = model.forward(emb_masked)
                new_logit_pos = logit_pos - 1 if i <= logit_pos else logit_pos
                
            else:  # 'evict'
                # کپی و حذف ستون i از cache
                past_kv_masked = copy_past_key_values(past_kv, remove_idx=i)
                _, logits_masked_per_step = model.generate_with_cache(
                    input_ids, past_kv_masked,
                    max_new_tokens=config['m'],
                    forced_tokens=Y,           # Teacher-Forcing
                    return_logits=True
                )
                p_masked = softmax(logits_masked_per_step[k])
                # برای 'evict'، مستقیماً به ۳.۲ می‌رویم
                continue
            
            # استخراج p_masked برای zero/remove
            if config['mask_scheme'] != 'evict':
                p_masked = softmax(logits_masked[0, new_logit_pos, :])
            
            # ---------- ۳.۲: محاسبه واگرایی ----------
            if config['divergence_metric'] == 'kl':
                diff = kl_div(p_full, p_masked, eps)
            else:
                diff = jsd_div(p_full, p_masked, eps)
            
            # ---------- ۳.۳: انباشت ----------
            imp[i] += diff
    
    # ---------- گام ۴: نرمال‌سازی ----------
    imp_norm = normalize_importance(imp, config['normalization'], eps)
    
    # ---------- گام ۵: انتخاب توکن‌های مهم ----------
    num_important = int(config['important_fraction'] * N)
    top_indices = np.argsort(imp_norm)[::-1][:num_important]
    
    return imp_norm, top_indices


# توابع کمکی
def softmax(x):
    x_shift = x - np.max(x)
    return np.exp(x_shift) / np.sum(np.exp(x_shift))

def kl_div(p, q, eps):
    p = np.clip(p, eps, 1.0)
    q = np.clip(q, eps, 1.0)
    return np.sum(p * np.log(p / q))

def jsd_div(p, q, eps):
    p = np.clip(p, eps, 1.0)
    q = np.clip(q, eps, 1.0)
    m = (p + q) / 2.0
    return 0.5 * kl_div(p, m, eps) + 0.5 * kl_div(q, m, eps)

def copy_past_key_values(past_kv, remove_idx):
    """کپی از cache و حذف ستون remove_idx در هر لایه و هد"""
    new_past_kv = []
    for layer_kv in past_kv:
        k, v = layer_kv
        k_new = torch.cat([k[:, :, :remove_idx, :], k[:, :, remove_idx+1:, :]], dim=2)
        v_new = torch.cat([v[:, :, :remove_idx, :], v[:, :, remove_idx+1:, :]], dim=2)
        new_past_kv.append((k_new, v_new))
    return new_past_kv

def normalize_importance(imp, method, eps):
    if method == 'max':
        return imp / (np.max(imp) + eps)
    elif method == 'minmax':
        return (imp - np.min(imp)) / (np.max(imp) - np.min(imp) + eps)
    elif method == 'softmax':
        imp_shift = imp - np.max(imp)
        exp_vals = np.exp(imp_shift)
        return exp_vals / (np.sum(exp_vals) + eps)
    else:  # 'zscore'
        mu = np.mean(imp)
        sigma = np.std(imp)
        return (imp - mu) / (sigma + eps)
```

