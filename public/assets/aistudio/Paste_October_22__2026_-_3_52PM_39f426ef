## 🛠️ ۷. پیشنهاد عملی برای پیاده‌سازی

### ساختار ماژول Oracle Importance:

```python
# oracle_importance.py

class OracleImportance:
    def __init__(self, model, tokenizer, metric):
        self.model = model
        self.tokenizer = tokenizer
        self.metric = metric  # مثلاً ExactMatch یا F1
        
    def compute_token_importance(
        self, 
        prompt: str, 
        reference_answer: str,
        window_size: int = 32,
        stride: int = 16,
        teacher_force: bool = True
    ) -> List[float]:
        """
        محاسبه‌ی اهمیت هر توکن با روش Epiphany-Aware
        
        Args:
            prompt: متن پرامپت
            reference_answer: پاسخ مرجع (تولیدشده با پرامپت کامل)
            window_size: اندازه‌ی پنجره برای پوشاندن
            stride: گام پنجره (برای همپوشانی)
            teacher_force: استفاده از Teacher-Forcing یا Resampling
            
        Returns:
            اهمیت نرمال‌شده‌ی هر توکن
        """
        tokens = self.tokenizer.encode(prompt)
        N = len(tokens)
        importance = np.zeros(N)
        
        # 1. تولید پاسخ مرجع با پرامپت کامل
        full_output = self.model.generate(prompt)
        full_answer = self.extract_answer(full_output)
        
        # 2. تولید پاسخ‌های پوشانده‌شده
        for start in range(0, N, stride):
            end = min(start + window_size, N)
            
            # پوشاندن پنجره (نه حذف)
            masked_tokens = tokens.copy()
            for i in range(start, end):
                masked_tokens[i] = self.mask_token_id  # [MASK] یا padding
            
            masked_prompt = self.tokenizer.decode(masked_tokens)
            
            # Teacher-Forcing: ادامه‌ی مرجع را تحمیل کن
            if teacher_force:
                masked_output = self.model.forward_with_teacher_force(
                    masked_prompt, 
                    reference_tokens=full_answer
                )
            else:
                masked_output = self.model.generate(masked_prompt)
            
            masked_answer = self.extract_answer(masked_output)
            
            # برچسب‌گذاری: آیا پاسخ عوض شد؟
            is_correct = self.metric.is_correct(masked_answer, full_answer)
            
            # تخصیص اهمیت به توکن‌های پنجره
            for i in range(start, end):
                if not is_correct:
                    importance[i] += 1.0 / (end - start)
        
        # نرمال‌سازی
        importance = importance / np.max(importance) if np.max(importance) > 0 else importance
        return importance
```

