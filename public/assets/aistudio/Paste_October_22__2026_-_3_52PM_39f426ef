## 🧠 ۸. کاربرد در ایده‌ی شما

### ۸.۱. کد کامل با نرمال‌سازی

```python
import numpy as np

def compute_normalized_importance(prompt, model, m=100):
    """
    محاسبه‌ی اهمیت نرمال‌شده‌ی هر توکن
    """
    N = len(prompt)
    imp = np.zeros(N)
    
    # تولید توکن‌های آینده با پرامپت کامل
    full_tokens, full_probs = model.generate_with_probs(prompt, m)
    
    for i in range(N):
        reduced_prompt = prompt[:i] + prompt[i+1:]
        reduced_tokens, reduced_probs = model.generate_with_probs(reduced_prompt, m)
        
        total_jsd = 0
        for k in range(m):
            P_full = full_probs[k]
            P_reduced = reduced_probs[k]
            M = (P_full + P_reduced) / 2
            kl1 = np.sum(P_full * np.log(P_full / M))
            kl2 = np.sum(P_reduced * np.log(P_reduced / M))
            jsd = 0.5 * kl1 + 0.5 * kl2
            total_jsd += jsd
        
        imp[i] = total_jsd
    
    # نرمال‌سازی Max-only (روش پیشنهادی شما)
    imp_norm = imp / np.max(imp)
    
    return imp_norm

# استفاده
importance = compute_normalized_importance(prompt, model)

# تعیین آستانه برای نگهداری توکن‌ها
threshold = 0.1  # فقط توکن‌هایی با اهمیت > ۱۰٪
important_tokens = [t for t, imp in zip(prompt, importance) if imp >= threshold]
```

### ۸.۲. انتخاب آستانه

با نرمال‌سازی، می‌توانید به راحتی آستانه‌های مختلف را آزمایش کنید:

```python
