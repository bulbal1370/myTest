plt.hist(importance, bins=20)
plt.axvline(x=0.1, color='r', linestyle='--', label='Threshold=0.1')
plt.axvline(x=0.2, color='g', linestyle='--', label='Threshold=0.2')
plt.xlabel('Importance (normalized)')
plt.ylabel('Number of tokens')
plt.legend()
plt.show()

# تعداد توکن‌های نگهداری‌شده در هر آستانه
for threshold in [0.05, 0.1, 0.15, 0.2, 0.3]:
    kept = np.sum(importance >= threshold)
    print(f"Threshold {threshold}: نگهداری {kept} توکن از {len(importance)}")
```

